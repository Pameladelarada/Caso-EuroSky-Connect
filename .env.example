# Copia este archivo como .env y completa los valores.
#   cp .env.example .env

# Clave de la API de Google Maps (opcional).
# Sin ella el sistema funciona completo: solo no se dibuja el mapa.
#
# IMPORTANTE: esta clave se entrega al navegador, es inevitable con Maps JS.
# Restringela por referrer HTTP en la consola de Google Cloud
# (APIs y servicios > Credenciales > Restricciones de la aplicacion)
# para que solo funcione desde tus dominios.
GOOGLE_MAPS_API_KEY=

# Puerto del servidor (por defecto 3000)
PORT=3000
